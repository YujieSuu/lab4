<!-- Optional bonus: a DTD for book.xml (connects to Topic 5 lecture).
     The lab only asks for "well-formed" XML, but you can validate against
     this DTD to make your document "valid" too. -->
<!ELEMENT catalogue (book+)>
<!ELEMENT book (title, author, price)>
<!ATTLIST book id CDATA #REQUIRED>
<!ELEMENT title (#PCDATA)>
<!ELEMENT author (#PCDATA)>
<!ELEMENT price (#PCDATA)>
